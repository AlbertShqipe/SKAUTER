<div class="homepage">
  <div class="homepage-hero">
    <%= image_tag 'logo.png', class:"img-hero" %>
    <p>Albania's premier production partner</p>
  </div>

  <div class="homepage-choices">

    <%= link_to services_path, class: "choice-card" do %>
      <%# <div class="choice-icon">🎬</div> %>
      <h2>Production Services</h2>
      <p>Line production, crew, logistics, permits and full on-the-ground support across Albania.</p>
      <span class="choice-cta">Explore Services →</span>
    <% end %>

    <%= link_to scouting_path, class: "choice-card" do %>
      <%# <div class="choice-icon">📍</div> %>
      <h2>Location Scouting</h2>
      <p>Browse and book Albania's most cinematic filming locations — from mountains to coastline.</p>
      <span class="choice-cta">Find Locations →</span>
    <% end %>

  </div>
</div>
