<%# app/views/pages/services.html.erb %>
<div class="services-page">
  <div class="services-hero">
    <%= image_tag 'logo.png', class:"img-hero" %>
    <p>Full-service production support across Albania</p>
  </div>

  <div class="services-content">
    <div class="services-grid">

      <div class="service-card">
        <%# <div class="service-icon">🎬</div>  %>
        <h3>Production Management & Line Production</h3>
        <p>End-to-end management of your production from pre to post, keeping schedules and budgets on track.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">🗺️</div> %>
        <h3>Local Fixing & Production Coordination</h3>
        <p>On-the-ground expertise to navigate local systems, contacts, and logistics seamlessly.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">📍</div> %>
        <h3>Location Scouting & Permitting</h3>
        <p>Finding the perfect locations and handling all necessary permits and authorisations.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">👥</div> %>
        <h3>Crew Sourcing & Staffing</h3>
        <p>Access to a vetted network of local and international crew across all departments.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">🚐</div> %>
        <h3>Logistics, Transport & On-the-Ground Coordination</h3>
        <p>Full transport and movement logistics for cast, crew, and equipment throughout Albania.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">🏨</div> %>
        <h3>Accommodation & Travel Arrangements</h3>
        <p>Hotel sourcing, travel planning, and accommodation management for your entire team.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">🍽️</div> %>
        <h3>On-Set Catering & Craft Services</h3>
        <p>Quality catering and craft services to keep your cast and crew fuelled on set.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">🎥</div> %>
        <h3>Equipment Hire & Technical Support</h3>
        <p>Camera, lighting, grip and technical equipment hire with experienced technical support.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">📋</div> %>
        <h3>Production Administration & Budgeting</h3>
        <p>Full production accounting, budgeting and administrative support throughout your shoot.</p>
      </div>

      <div class="service-card">
        <%# <div class="service-icon">⚖️</div> %>
        <h3>Legal, Insurance & Compliance Support</h3>
        <p>Navigating Albanian regulations, insurance requirements and compliance for peace of mind.</p>
      </div>

    </div>

    <div class="services-cta">
      <h2>Ready to start your production?</h2>
      <p>Get in touch and we'll put together a tailored package for your project.</p>
      <%= link_to "Contact Us", contact_path, class: "btn btn-navbar btn-gold-shimmer" %>
    </div>
  </div>
</div>
