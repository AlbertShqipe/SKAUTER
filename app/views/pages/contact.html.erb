<div class="contact-page">
  <div class="contact-hero">
    <h1>Get in Touch</h1>
    <p>Have a project in mind? We'd love to hear from you.</p>
  </div>

  <div class="contact-content">

    <% if notice.present? %>
      <div class="contact-notice">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="contact-alert">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: send_contact_path, method: :post, class: "contact-form" do |f| %>

      <div class="form-group">
        <label for="name">Your Name</label>
        <input type="text"
               id="name"
               name="name"
               required
               placeholder="Jane Smith"
               value="<%= params[:name] %>">
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email"
               id="email"
               name="email"
               required
               placeholder="jane@studio.com"
               value="<%= params[:email] %>">
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message"
                  name="message"
                  rows="6"
                  required
                  placeholder="Tell us about your project..."><%= params[:message] %></textarea>
      </div>

      <button type="submit" class="btn-primary">Send Message</button>

    <% end %>

    <div class="contact-info">
      <p>Or email us directly at : </p>
      <ul class="contact-emails">
        <li><a href="mailto:jay@skauter.al">jay@skauter.al</a></li>
        <li><a href="mailto:klevis@skauter.al">klevis@skauter.al</a></li>
        <li><a href="mailto:chris@skauter.al">chris@skauter.al</a></li>
      </ul>
    </div>
  </div>
</div>
